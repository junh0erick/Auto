  67:pendulo.c     **** /* ============================================================
  68:pendulo.c     ****    pendulo_calibrate_rest()
  69:pendulo.c     ****    Marca la posición ACTUAL del péndulo (debería estar en reposo,
  70:pendulo.c     ****    colgando libremente ≈ 180°) como referencia de 180°. Almacena el
  71:pendulo.c     ****    conteo crudo de QuadDec_2 y resincroniza g_prev_motor_count.
  72:pendulo.c     ****    pendulo_read() usa esta referencia para calcular θ relativo a la
  73:pendulo.c     ****    vertical (θ=0 cuando se rota ±π desde el reposo).
  74:pendulo.c     ****    ============================================================ */
