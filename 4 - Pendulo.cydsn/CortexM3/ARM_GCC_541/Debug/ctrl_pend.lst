 623:ctrl_pend.c   ****     q7_t Ax1 = qsat7((q15_t)(dot7 >> 7));
 624:ctrl_pend.c   ****     z[1] = q7_to_flt(qsat7((q15_t)Ax1 + Buq[1])) * qs;
 625:ctrl_pend.c   **** }
