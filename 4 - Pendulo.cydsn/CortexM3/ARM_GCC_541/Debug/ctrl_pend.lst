 202:ctrl_pend.c   **** /* ============================================================
 203:ctrl_pend.c   ****    Q-format inline conversions
 204:ctrl_pend.c   ****    Convención: todos los valores representados como fracción de
 205:ctrl_pend.c   ****    q_scale, es decir: q_val = physical_val / q_scale ∈ [-1, 1).
 206:ctrl_pend.c   ****    ============================================================ */
 207:ctrl_pend.c   **** 
 208:ctrl_pend.c   **** /* Float normalizado [-1,1) → Q31 */
 209:ctrl_pend.c   **** static inline q31_t flt_to_q31n(float v) {
ARM GAS  C:\Users\user\AppData\Local\Temp\ccoNEg7E.s 			page 7


 210:ctrl_pend.c   ****     if (v >= 1.0f)  return  (q31_t)0x7FFFFFFF;
 211:ctrl_pend.c   ****     if (v < -1.0f)  return  (q31_t)0x80000000;
 212:ctrl_pend.c   ****     return (q31_t)(v * 2147483648.0f);
 213:ctrl_pend.c   **** }
 214:ctrl_pend.c   **** /* Q31 → float normalizado [-1,1) */
 215:ctrl_pend.c   **** static inline float q31_to_flt(q31_t v) {
 216:ctrl_pend.c   ****     return (float)v * (1.0f / 2147483648.0f);
 217:ctrl_pend.c   **** }
 218:ctrl_pend.c   **** 
 219:ctrl_pend.c   **** /* Float normalizado [-1,1) → Q15 */
 220:ctrl_pend.c   **** static inline q15_t flt_to_q15n(float v) {
 221:ctrl_pend.c   ****     if (v >= 1.0f)  return  (q15_t)0x7FFF;
 222:ctrl_pend.c   ****     if (v < -1.0f)  return  (q15_t)0x8000;
 223:ctrl_pend.c   ****     return (q15_t)(v * 32768.0f);
 224:ctrl_pend.c   **** }
 225:ctrl_pend.c   **** /* Q15 → float normalizado */
 226:ctrl_pend.c   **** static inline float q15_to_flt(q15_t v) {
 227:ctrl_pend.c   ****     return (float)v * (1.0f / 32768.0f);
 228:ctrl_pend.c   **** }
 229:ctrl_pend.c   **** 
 230:ctrl_pend.c   **** /* Float normalizado [-1,1) → Q7 */
 231:ctrl_pend.c   **** static inline q7_t flt_to_q7n(float v) {
 232:ctrl_pend.c   ****     if (v >= 1.0f)  return  (q7_t)0x7F;
 233:ctrl_pend.c   ****     if (v < -1.0f)  return  (q7_t)0x80;
 234:ctrl_pend.c   ****     return (q7_t)(v * 128.0f);
 235:ctrl_pend.c   **** }
 236:ctrl_pend.c   **** /* Q7 → float normalizado */
 237:ctrl_pend.c   **** static inline float q7_to_flt(q7_t v) {
 238:ctrl_pend.c   ****     return (float)v * (1.0f / 128.0f);
 239:ctrl_pend.c   **** }
 240:ctrl_pend.c   **** 
 241:ctrl_pend.c   **** /* Saturating add helpers para escalares Q */
 242:ctrl_pend.c   **** static inline q31_t qsat31(q63_t v) {
 243:ctrl_pend.c   ****     if (v > (q63_t)0x7FFFFFFF)  return (q31_t)0x7FFFFFFF;
 244:ctrl_pend.c   ****     if (v < (q63_t)0xFFFFFFFF80000000LL) return (q31_t)0x80000000;
 245:ctrl_pend.c   ****     return (q31_t)v;
 246:ctrl_pend.c   **** }
