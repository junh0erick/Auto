 628:ctrl_pend.c   **** {
 629:ctrl_pend.c   ****     float qs = lp->q_scale;
 630:ctrl_pend.c   ****     q7_t xhat_q[2];
 631:ctrl_pend.c   ****     q31_t dot7;
 632:ctrl_pend.c   **** 
 633:ctrl_pend.c   ****     xhat_q[0] = flt_to_q7n(lp->xhat[0] / qs);
 634:ctrl_pend.c   ****     xhat_q[1] = flt_to_q7n(lp->xhat[1] / qs);
 635:ctrl_pend.c   **** 
 636:ctrl_pend.c   ****     arm_dot_prod_q7(lp->qK7, xhat_q, 2u, &dot7);
 637:ctrl_pend.c   ****     q7_t kx = qsat7((q15_t)(dot7 >> 7));
 638:ctrl_pend.c   **** 
 639:ctrl_pend.c   ****     float extra_f = mode_has_i(lp->mode) ? (lp->Kx * lp->vint)
 640:ctrl_pend.c   ****                                          : (lp->Kx * lp->ref);
 641:ctrl_pend.c   ****     q7_t extra_q = flt_to_q7n(extra_f / qs);
 642:ctrl_pend.c   **** 
 643:ctrl_pend.c   ****     return q7_to_flt(qsat7((q15_t)extra_q - kx)) * qs;
 644:ctrl_pend.c   **** }
