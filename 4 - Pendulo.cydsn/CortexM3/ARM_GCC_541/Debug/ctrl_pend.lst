 366:ctrl_pend.c   **** static void ss_predict_q31(CtrlLoop *lp, const float x[2], float u, float z[2])
 367:ctrl_pend.c   **** {
 368:ctrl_pend.c   ****     float qs = lp->q_scale;
 369:ctrl_pend.c   ****     q31_t xq[2], Buq[2];
 370:ctrl_pend.c   ****     q63_t dot;
 371:ctrl_pend.c   **** 
 372:ctrl_pend.c   ****     xq[0] = flt_to_q31n(x[0] / qs);
 373:ctrl_pend.c   ****     xq[1] = flt_to_q31n(x[1] / qs);
 374:ctrl_pend.c   ****     q31_t uq = flt_to_q31n(u / qs);
 375:ctrl_pend.c   **** 
 376:ctrl_pend.c   ****     /* B·u: arm_scale_q31 escala el vector B por el escalar u.
ARM GAS  C:\Users\user\AppData\Local\Temp\ccYWN9em.s 			page 17


 377:ctrl_pend.c   ****        Resultado: Buq[i] = (B_q31[i] × uq) >> 31 → Q31 */
 378:ctrl_pend.c   ****     arm_scale_q31(lp->qB31, uq, 0, Buq, 2u);
 379:ctrl_pend.c   **** 
 380:ctrl_pend.c   ****     /* Fila 0: A[0..1]·x */
 381:ctrl_pend.c   ****     arm_dot_prod_q31(&lp->qA31[0], xq, 2u, &dot);
 382:ctrl_pend.c   ****     q31_t Ax0 = (q31_t)(dot >> 17);
 383:ctrl_pend.c   ****     z[0] = q31_to_flt(qsat31((q63_t)Ax0 + Buq[0])) * qs;
 384:ctrl_pend.c   **** 
 385:ctrl_pend.c   ****     /* Fila 1: A[2..3]·x */
 386:ctrl_pend.c   ****     arm_dot_prod_q31(&lp->qA31[2], xq, 2u, &dot);
 387:ctrl_pend.c   ****     q31_t Ax1 = (q31_t)(dot >> 17);
 388:ctrl_pend.c   ****     z[1] = q31_to_flt(qsat31((q63_t)Ax1 + Buq[1])) * qs;
 389:ctrl_pend.c   **** }
 390:ctrl_pend.c   **** 
 391:ctrl_pend.c   **** static float ss_u_cmd_q31(CtrlLoop *lp)
 392:ctrl_pend.c   **** {
 393:ctrl_pend.c   ****     float qs = lp->q_scale;
 394:ctrl_pend.c   ****     q31_t xhat_q[2];
 395:ctrl_pend.c   ****     q63_t dot;
 396:ctrl_pend.c   **** 
 397:ctrl_pend.c   ****     xhat_q[0] = flt_to_q31n(lp->xhat[0] / qs);
 398:ctrl_pend.c   ****     xhat_q[1] = flt_to_q31n(lp->xhat[1] / qs);
 399:ctrl_pend.c   **** 
 400:ctrl_pend.c   ****     arm_dot_prod_q31(lp->qK31, xhat_q, 2u, &dot);
 401:ctrl_pend.c   ****     q31_t kx = (q31_t)(dot >> 17);
 402:ctrl_pend.c   **** 
 403:ctrl_pend.c   ****     /* extra = Kx * vint_or_ref — calculado en float, luego normalizado */
 404:ctrl_pend.c   ****     float extra_f = mode_has_i(lp->mode) ? (lp->Kx * lp->vint)
 405:ctrl_pend.c   ****                                          : (lp->Kx * lp->ref);
 406:ctrl_pend.c   ****     q31_t extra_q = flt_to_q31n(extra_f / qs);
 407:ctrl_pend.c   **** 
 408:ctrl_pend.c   ****     return q31_to_flt(qsat31((q63_t)extra_q - kx)) * qs;
 409:ctrl_pend.c   **** }
 410:ctrl_pend.c   **** 
 411:ctrl_pend.c   **** static void ss_obs_pred_q31(CtrlLoop *lp, float y, float u_prev, float u_k)
 412:ctrl_pend.c   **** {
 413:ctrl_pend.c   ****     float qs = lp->q_scale;
 414:ctrl_pend.c   **** 
 415:ctrl_pend.c   ****     /* innov = y - ŷ(xhat, u_prev) */
 416:ctrl_pend.c   ****     float innov = y - ss_yhat_q31(lp, lp->xhat, u_prev);
 417:ctrl_pend.c   ****     q31_t innov_q = flt_to_q31n(innov / qs);
 418:ctrl_pend.c   **** 
 419:ctrl_pend.c   ****     /* z = A·xhat + B·u_k (resultado en float) */
 420:ctrl_pend.c   ****     float z[2];
 421:ctrl_pend.c   ****     ss_predict_q31(lp, lp->xhat, u_k, z);
 422:ctrl_pend.c   **** 
 423:ctrl_pend.c   ****     /* Linv = L × innov: arm_scale_q31(L_q, innov_q, shift=0, Linv, 2) */
 424:ctrl_pend.c   ****     q31_t Linv[2];
 425:ctrl_pend.c   ****     arm_scale_q31(lp->qL31, innov_q, 0, Linv, 2u);
 426:ctrl_pend.c   **** 
 427:ctrl_pend.c   ****     /* xhat = z + Linv (suma Q31 saturada) */
 428:ctrl_pend.c   ****     q31_t zq[2];
 429:ctrl_pend.c   ****     zq[0] = flt_to_q31n(z[0] / qs);
 430:ctrl_pend.c   ****     zq[1] = flt_to_q31n(z[1] / qs);
 431:ctrl_pend.c   ****     q31_t xhat_q[2];
 432:ctrl_pend.c   ****     arm_add_q31(zq, Linv, xhat_q, 2u);
 433:ctrl_pend.c   **** 
ARM GAS  C:\Users\user\AppData\Local\Temp\ccYWN9em.s 			page 18


 434:ctrl_pend.c   ****     lp->xhat[0] = q31_to_flt(xhat_q[0]) * qs;
 435:ctrl_pend.c   ****     lp->xhat[1] = q31_to_flt(xhat_q[1]) * qs;
 436:ctrl_pend.c   **** }
