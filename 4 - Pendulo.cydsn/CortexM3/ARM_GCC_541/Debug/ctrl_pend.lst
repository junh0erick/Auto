 606:ctrl_pend.c   **** {
 607:ctrl_pend.c   ****     float qs = lp->q_scale;
 608:ctrl_pend.c   ****     q7_t xq[2], Buq[2];
 609:ctrl_pend.c   ****     q31_t dot7;
 610:ctrl_pend.c   **** 
 611:ctrl_pend.c   ****     xq[0] = flt_to_q7n(x[0] / qs);
